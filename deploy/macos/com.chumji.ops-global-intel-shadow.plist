<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chumji.ops-global-intel-shadow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-B</string>
    <string>/Users/ops/services/chumji-ops/jobs/global-intel/run_shadow.py</string>
    <string>--output-root</string>
    <string>/Users/ops/Library/Application Support/chumji-ops/shadow/global-intel</string>
    <string>--acled-secret-file</string>
    <string>/Users/ops/.config/chumji-ops/secrets/acled.env</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>50</integer>
  </dict>
  <key>UserName</key>
  <string>ops</string>
  <key>WorkingDirectory</key>
  <string>/Users/ops/services/chumji-ops/jobs/global-intel</string>
  <key>StandardOutPath</key>
  <string>/Users/ops/Library/Logs/chumji-ops/global-intel-shadow.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ops/Library/Logs/chumji-ops/global-intel-shadow.error.log</string>
</dict>
</plist>
